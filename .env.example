# Server Configuration
PORT=3000
HOST=0.0.0.0

# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=audiocom_prod
LIVEKIT_API_SECRET=your_livekit_secret_here

# LiveKit advertised public IP for ICE candidates (set this on your server)
LIVEKIT_NODE_IP=64.227.189.7

# Node -> LiveKit proxy target (local to the VM)
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880

# coturn (native install) shared secret
# Generate with: openssl rand -hex 32
# This MUST match static-auth-secret in /etc/turnserver.conf
# AND the 'secret' fields in livekit.conf turn_servers
TURN_STATIC_AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
